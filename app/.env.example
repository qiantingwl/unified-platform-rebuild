# Copy to .env on the server and fill in. Never commit or share the real .env.
# Generate values on the server:
#   UNIFIED_ADMIN_TOKEN:    python -c "import secrets; print(secrets.token_urlsafe(32))"
#   UNIFIED_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up UNIFIED_ENCRYPTION_KEY separately from the database: losing it makes every stored credential unreadable.

UNIFIED_ADMIN_TOKEN=
UNIFIED_ENCRYPTION_KEY=
DB_PASSWORD=
# Shared secret between the app and the browser executor (>=16 chars).
BROWSER_EXECUTOR_TOKEN=
# Public https origin of the console behind the reverse proxy, e.g. https://unified.example.com
UNIFIED_PUBLIC_ORIGIN=

# Optional
UNIFIED_PORT=4180
# Use 0.0.0.0 for direct IP:port access; for HTTP also set SECURE_COOKIE=0
# and PUBLIC_ORIGIN=http://SERVER_IP:4180. Keep loopback for a local TLS proxy.
UNIFIED_BIND_ADDRESS=127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1
UNIFIED_MAINTENANCE_CAPACITY=64
# Emergency stop: set to 0 to block all upstream traffic (sign-in, balance, registration, forwarding).
UNIFIED_ENABLE_UPSTREAM=1
UNIFIED_SECURE_COOKIE=1
BROWSER_MAX_SESSIONS=8
BROWSER_MEM_LIMIT=3g
BROWSER_CPUS=2

# Maximum accepted forwarding request body; preserves long history, never silently trims.
UNIFIED_MAX_REQUEST_BYTES=33554432
